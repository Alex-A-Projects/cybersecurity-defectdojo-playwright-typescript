# =============================================================================
# DefectDojo test framework — environment variables
# Copy this file to `.env` and fill in values. Never commit `.env`.
# =============================================================================

# ── Environment selector ───────────────────────────────────────────────
# Which environment the tests run against: demo (the only env today —
# DefectDojo's public sandbox at demo.defectdojo.org).
TEST_ENV=demo

# ── Frontend / UI base URLs ────────────────────────────────────────────
# Single env today. Backend/API URL is selected independently (see below).
DEMO_BASE_URL=https://demo.defectdojo.org

# ── Backend / API base URL ─────────────────────────────────────────────
# Independent axis — the API suite runs here even if it differs from the UI.
DEMO_API_URL=https://demo.defectdojo.org

# ── Authentication ─────────────────────────────────────────────────────
# Sandbox admin credentials. Do NOT use in production.
# The value below is the public demo sandbox credential; replace it with
# a secret from your own vault if you point the framework elsewhere.
# NOTE: wrap passwords in quotes so `#` characters are not stripped as comments.
TEST_USER="admin"
TEST_PASSWORD="<sandbox password>"

# ── Database (DB suite, Dockerised PostgreSQL 16) ───────────────────────
# Connection details for the container started by `npm run db:up`.
# Default DD_DB_PORT=55432 instead of 5432/5433 because Mac users often
# have Homebrew or leftover Postgres containers already bound to either
# of those ports. docker-compose.yml maps the host port at the env-var
# value, so change one place to move the framework off a conflicting port.
DD_DB_HOST=localhost
DD_DB_PORT=55432
DD_DB_NAME=defectdojo
DD_DB_USER=defectdojo
DD_DB_PASSWORD=defectdojo
DD_DB_SSL=false

# ── Cookies / feature-flag override (UI suite, optional) ───────────────
# Cookie domain for any cross-subdomain storage operations.
COOKIE_DOMAIN=demo.defectdojo.org

# ── Test runtime ────────────────────────────────────────────────────────
# Per-test default timeout in ms.
TEST_TIMEOUT=30000
